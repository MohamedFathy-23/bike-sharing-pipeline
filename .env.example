# Copy this file to .env and set your own values. Never commit .env.

# PostgreSQL
POSTGRES_USER=bike_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bike_sharing
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
PGADMIN_PORT=5050

# Ingestion (Phase 2). No secrets here.
INGEST_SOURCE_URL=https://archive.ics.uci.edu/static/public/275/bike+sharing+dataset.zip
INGEST_ALLOW_LOCAL_FALLBACK=true
INGEST_MAX_RETRIES=3
